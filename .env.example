# توكن البوت من BotFather
BOT_TOKEN=

# معرّفات الأدمن الأساسيين مفصولة بفاصلة (لا يمكن إزالتهم من لوحة التحكم)
SUPER_ADMINS=

# رابط قاعدة البيانات (افتراضيًا SQLite، يمكن تغييره لـ PostgreSQL بسهولة)
# مثال PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/botdb
DATABASE_URL=sqlite+aiosqlite:///bot.db

# مفاتيح مزودي الذكاء الاصطناعي (يمكن أيضًا تعديلها من لوحة الأدمن لاحقًا)
CLAUDE_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEFAULT_AI_PROVIDER=google
